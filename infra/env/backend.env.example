APP_NAME=Mental Health Backend
APP_ENV=dev
APP_DEBUG=true

QWEN_ENABLED=true
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_STORE_BACKEND=in_memory
EMBEDDINGS_PROVIDER=bge_m3_http
EMBEDDINGS_BGE_ENDPOINT=/embed

DB_DSN=postgresql://mentalhealth:YOUR_PASSWORD@postgres:5432/mentalhealth
QWEN_BASE_URL=http://qwen:3264/api
EMBEDDINGS_BGE_BASE_URL=http://bge-gateway:8001